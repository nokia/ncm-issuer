# Editor defaults for this repository. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs, and a recipe line in a makefile has to start with one
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.sh]
indent_style = tab

# Two trailing spaces are a hard line break in Markdown, so they must survive a save
[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2
