# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# builds directory
builds/
bin/

# packaged release tarballs produced by `make pack-app`
ncm-issuer-*.tar.gz

# Rendered mkdocs output and packaged Helm charts. Both are built in CI and published to the
# gh-pages branch, so they must never be committed back onto main. mkdocs treats anything inside
# docs/ as a page or a static file, so a stray build here gets published as dead weight.
site/
*.tgz
charts/
docs/**/*.html
docs/404.html
docs/sitemap.xml
docs/sitemap.xml.gz
docs/search/
docs/assets/javascripts/
docs/assets/stylesheets/
docs/assets/images/favicon.png

# Dependency directories
vendor/

# Go workspace files
go.work
go.work.sum

# VSCode settings folder
.vscode/

# Intelij settings folder
.idea/

# Coverage profile written by `make test`
coverage.out

# dotenv files
.env*

# Config files
*.conf

# Local development and temporary files
local/
tmp/

# IDE & editor metadata
.cursor/
.cursorignore
.cursorindexingignore
*.sublime-project
*.sublime-workspace
.vscode/
.idea/
.abstra/
*.swp
*.swo

# Credentials, certs, pkeys and config snapshots
*.pem
*.key
*.crt
*.p12
*.jks
*.der
*.token
*.secret
*.auth
*.bak
*.old
*.orig

# macOS metadata
.DS_Store
*.DS_Store
